[Unit]
Description=FM350-GL USB Modem Manager & Watchdog
Documentation=file:///usr/local/share/doc/fm350-monitor/architecture.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Sysfs autosuspend/power/control and USBDEVFS_RESET need elevated privileges.
User=root
Group=root
# Build: go build -o /usr/local/bin/fm350-manager ./cmd/app
# Bind localhost by default (not 0.0.0.0). Optional API token:
#   Environment=FM350_API_TOKEN=change-me
#   or: ExecStart=… -token change-me
ExecStart=/usr/local/bin/fm350-manager -bind 127.0.0.1 -port 8080 -history-file /var/lib/fm350-manager/history.json
# EnvironmentFile=-/etc/fm350-manager.env
Restart=on-failure
RestartSec=3
# Hardening (keep CAP for raw USB/sysfs if you drop root later)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/sys/module/usbcore/parameters /sys/bus/usb/devices /dev/bus/usb /var/lib/fm350-manager /run/fm350-manager
StateDirectory=fm350-manager
RuntimeDirectory=fm350-manager
# Hotspot needs host tools on PATH: hostapd dnsmasq iw iproute2 nftables|iptables
PrivateTmp=true

[Install]
WantedBy=multi-user.target
